# Supabase (shared backend — registrations/results sync across all devices)
# Copy this file to .env.local and fill in real values from:
#   Supabase → Project Settings → API → Project URL + anon public key
# Without these, sites still works but data stays per-browser (localStorage).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: admin code override (default: fieles-2026-campeon)
# NEXT_PUBLIC_ADMIN_CODE=change-me